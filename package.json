{
  "name": "nerey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless generative UI for React, with a separately shipped CSS Modules theme.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf packages/*/dist storybook-static coverage .vitest-reports",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:visual:update": "docker run --rm -v \"$PWD\":/work -v nerey-visual-modules:/work/node_modules -w /work mcr.microsoft.com/playwright:v1.62.1-noble sh -c 'npm ci --no-audit --no-fund && npx vitest run --config vitest.visual.config.ts -u'",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "gen:tokens": "node scripts/gen-tokens.mjs",
    "gen:css-types": "node scripts/gen-css-types.mjs",
    "gen:check": "node scripts/gen-tokens.mjs --check && node scripts/gen-css-types.mjs --check",
    "gen:release": "node scripts/gen-release.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:core-purity": "node scripts/check-core-purity.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:data-contract": "node scripts/check-data-contract.mjs",
    "check:stories": "node scripts/check-stories.mjs",
    "check:public-api": "node scripts/check-public-api.mjs",
    "check:api-signatures": "node scripts/check-api-signatures.mjs",
    "check:citations": "node scripts/check-adr-citations.mjs",
    "check:ci-pins": "node scripts/check-ci-pins.mjs",
    "check:commits": "node scripts/check-commits.mjs",
    "check:gates": "node scripts/check-gates.mjs",
    "check:boundaries": "depcruise packages",
    "check:spelling": "cspell --no-progress \"**/*.md\"",
    "check:all": "npm run check:tokens && npm run check:core-purity && npm run check:data-contract && npm run check:public-api && npm run check:api-signatures && npm run check:stories && npm run check:a11y && npm run check:citations && npm run check:commits && npm run check:boundaries && npm run check:ci-pins && npm run check:gates",
    "adr": "python3 .claude/skills/adr/scripts/adr.py",
    "typecheck:build": "tsc -p packages/core/tsconfig.build.json && tsc -p packages/theme/tsconfig.build.json",
    "check:a11y": "node scripts/check-a11y-waivers.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-vitest": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^10.0.1",
    "dependency-cruiser": "^17.4.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.7",
    "globals": "^16.5.0",
    "happy-css-modules": "^5.0.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}

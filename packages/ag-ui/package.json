{
  "name": "@nerey/ag-ui",
  "version": "0.0.0",
  "description": "AG-UI protocol adapter for @nerey/core — folds the event stream into widget messages and answers tool calls and interrupts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/real-case/nerey.git",
    "directory": "packages/ag-ui"
  },
  "homepage": "https://github.com/real-case/nerey/tree/main/packages/ag-ui#readme",
  "bugs": {
    "url": "https://github.com/real-case/nerey/issues"
  },
  "author": "Yurii Anichkin",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/fix-dts-specifiers.mjs ."
  },
  "peerDependencies": {
    "@ag-ui/core": "^1.0.0",
    "@nerey/core": "^0.1.0",
    "react": "^19.0.0"
  },
  "keywords": [
    "ag-ui",
    "generative-ui",
    "nerey",
    "react",
    "agents"
  ],
  "publishConfig": {
    "access": "public"
  }
}

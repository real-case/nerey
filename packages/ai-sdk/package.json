{
  "name": "@nerey/ai-sdk",
  "version": "0.1.0",
  "description": "Vercel AI SDK adapter for @nerey/core \u2014 tool parts become widget frames, widget answers become tool outputs, and the model's tools are derived from the registry.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/real-case/nerey.git",
    "directory": "packages/ai-sdk"
  },
  "homepage": "https://github.com/real-case/nerey/tree/main/packages/ai-sdk#readme",
  "bugs": {
    "url": "https://github.com/real-case/nerey/issues"
  },
  "author": "Yurii Anichkin",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "vite build && vite build --config vite.server.config.ts && tsc -p tsconfig.build.json && node ../../scripts/fix-dts-specifiers.mjs .",
    "dev": "vite build --watch"
  },
  "dependencies": {},
  "peerDependencies": {
    "@nerey/core": "^0.1.0",
    "ai": "^7.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "ai": "^7.0.183"
  },
  "keywords": [
    "generative-ui",
    "ai-sdk",
    "vercel-ai",
    "react",
    "tool-calling",
    "widgets"
  ],
  "publishConfig": {
    "access": "public"
  }
}
